:root {
  --brand: #2563eb;
  --brand-dark: #1747b8;
  --brand-soft: #eaf2ff;
  --orange: #fb923c;
  --yellow: #facc15;
  --ink: #26364a;
  --muted: #667085;
  --panel: #ffffff;
  --line: rgba(71, 96, 125, 0.16);
  --shadow: 0 18px 55px rgba(36, 54, 74, 0.18);
  --header-height: 78px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
  color: var(--ink);
  background: #dff4ff;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  min-height: 100%;
  margin: 0;
  overflow: hidden;
  background: #dff4ff;
}

body {
  min-height: 100vh;
  min-height: 100dvh;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
label[role="button"] {
  min-height: 44px;
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tabindex]:focus-visible {
  outline: 3px solid rgba(37, 99, 235, 0.3);
  outline-offset: 2px;
}

[hidden] {
  display: none !important;
}

.app-shell {
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
}

.topbar {
  position: relative;
  z-index: 1200;
  display: grid;
  grid-template-columns: auto auto minmax(190px, 1fr) minmax(210px, auto);
  align-items: center;
  gap: 12px;
  min-height: calc(var(--header-height) + var(--safe-top));
  padding: calc(10px + var(--safe-top)) calc(96px + var(--safe-right)) 10px calc(18px + var(--safe-left));
  border-bottom: 1px solid rgba(67, 112, 156, 0.17);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8px 28px rgba(51, 75, 101, 0.1);
  backdrop-filter: blur(18px);
}

.brand-logo-wrap {
  display: flex;
  align-items: center;
  width: 162px;
  min-height: 44px;
  overflow: visible;
  color: inherit;
  text-decoration: none;
}

.brand-logo-3d {
  display: flex;
  width: 160px;
  height: 44px;
  align-items: center;
  gap: 7px;
  perspective: 420px;
  transform-style: preserve-3d;
}

.brand-emblem {
  position: relative;
  display: grid;
  width: 43px;
  height: 37px;
  flex: 0 0 auto;
  place-items: center;
  border: 2px solid rgba(255, 255, 255, 0.96);
  border-radius: 14px 14px 17px 17px;
  color: #fff;
  background: linear-gradient(145deg, #52a6ff 0%, #1763e7 48%, #0a43b6 100%);
  box-shadow: inset 3px 3px 7px rgba(255, 255, 255, 0.48), inset -4px -5px 8px rgba(5, 49, 135, 0.34), 0 4px 0 #103d98, 0 7px 12px rgba(21, 84, 182, 0.26);
  transform: translateY(-2px) rotateX(5deg) rotateY(-7deg) rotateZ(-2deg);
}

.brand-emblem-text {
  transform: translateY(-2px);
  font-size: 21px;
  font-weight: 950;
  letter-spacing: -2px;
  line-height: 1;
  text-shadow: 0 2px 0 #0b3f9f, 0 3px 6px rgba(4, 33, 91, 0.32);
}

.brand-smile {
  position: absolute;
  right: 8px;
  bottom: 5px;
  left: 8px;
  height: 9px;
  border-bottom: 3px solid rgba(255, 255, 255, 0.96);
  border-radius: 0 0 50% 50%;
}

.brand-pin {
  position: absolute;
  top: -8px;
  right: -5px;
  width: 14px;
  height: 14px;
  border: 2px solid #fff;
  border-radius: 50% 50% 50% 2px;
  background: linear-gradient(145deg, #ffb34f, #f97316);
  box-shadow: 0 3px 5px rgba(194, 81, 12, 0.3);
  transform: rotate(-45deg) translateZ(6px);
}

.brand-pin::after {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #fff;
  content: "";
}

.brand-wordmark {
  display: flex;
  align-items: baseline;
  min-width: 0;
  font-size: 27px;
  font-weight: 950;
  letter-spacing: -1.7px;
  line-height: 1;
  transform: rotateX(2deg) translateZ(3px);
}

.brand-wordmark span {
  color: #1763e7;
  text-shadow: 0 1px 0 #fff, 0 2px 0 #c5dcff, 0 4px 6px rgba(28, 91, 181, 0.2);
}

.brand-wordmark b {
  color: #26364a;
  font-weight: 950;
  text-shadow: 0 1px 0 #fff, 0 2px 0 #d8dee7, 0 4px 6px rgba(38, 54, 74, 0.18);
}

.current-city {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 40px;
  padding: 7px 13px;
  border: 1px solid #dbeafe;
  border-radius: 999px;
  background: var(--brand-soft);
  color: var(--brand-dark);
  font-weight: 900;
  white-space: nowrap;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  height: 46px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: #f8fbff;
}

.search-box input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  color: var(--ink);
  background: transparent;
  font-weight: 700;
}

.filter-strip {
  display: flex;
  gap: 6px;
  min-width: 0;
  max-width: 570px;
  overflow-x: auto;
  scrollbar-width: none;
}

.filter-strip::-webkit-scrollbar {
  display: none;
}

.filter-chip {
  min-height: 44px;
  padding: 7px 11px;
  border: 1px solid transparent;
  border-radius: 999px;
  color: #475467;
  background: #f2f4f7;
  font-size: 12px;
  font-weight: 850;
  white-space: nowrap;
}

.filter-chip.active {
  border-color: #173f9f;
  color: #fff;
  background: #204eb6;
  box-shadow: 0 5px 14px rgba(37, 99, 235, 0.22);
}

.map-stage {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  isolation: isolate;
  background: #bde8ff;
}

.virtual-map {
  position: absolute;
  inset: 0;
  overflow: hidden;
  touch-action: manipulation;
  user-select: none;
  background: #bfe9ff;
}

.map-art,
.route-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.map-art {
  z-index: 1;
}

.map-art svg {
  display: block;
  width: 100%;
  height: 100%;
}

.map-art svg text {
  transform: scaleX(var(--map-text-scale-x, 1));
  transform-box: fill-box;
  transform-origin: center;
}

.route-overlay {
  z-index: 3;
  overflow: visible;
  pointer-events: none;
}

.route-line-shadow {
  fill: none;
  stroke: rgba(255, 255, 255, 0.86);
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.route-line {
  fill: none;
  stroke: var(--brand);
  stroke-width: 0.82;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 2.1 1.5;
  animation: routeMarch 1.2s linear infinite;
}

.route-dot {
  fill: var(--yellow);
  stroke: #fff;
  stroke-width: 0.6;
}

@keyframes routeMarch {
  to {
    stroke-dashoffset: -7.2;
  }
}

.marker-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}

.place-marker {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  max-width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 4px;
  border: 2px solid rgba(255, 255, 255, 0.96);
  border-radius: 999px;
  transform: translate(calc(-50% + var(--marker-nudge-x, 0px)), calc(-50% + var(--marker-nudge-y, 0px)));
  color: #203044;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 8px 20px rgba(32, 55, 79, 0.22);
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
  pointer-events: auto;
  touch-action: none;
  transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
}

.place-marker:hover,
.place-marker.selected {
  z-index: 90 !important;
  border-color: var(--orange);
  box-shadow: 0 10px 26px rgba(251, 146, 60, 0.32);
  transform: translate(calc(-50% + var(--marker-nudge-x, 0px)), calc(-50% + var(--marker-nudge-y, 0px))) scale(1.06);
}

.place-marker.in-plan {
  border-color: var(--brand);
  background: #f7fbff;
}

.place-marker.dragging {
  z-index: 100 !important;
  transition: none;
  transform: translate(calc(-50% + var(--marker-nudge-x, 0px)), calc(-50% + var(--marker-nudge-y, 0px))) scale(1.08) rotate(-1deg);
}

.place-marker .marker-emoji {
  position: relative;
  z-index: 1;
  display: grid;
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  background: var(--marker-color, #eaf2ff);
  font-size: 17px;
}

.text-icon {
  overflow: hidden;
  letter-spacing: -0.08em;
  text-indent: -0.04em;
  white-space: nowrap;
}

.place-marker .marker-emoji.text-icon {
  font-size: 12px;
}

.place-marker .marker-name {
  position: absolute;
  z-index: 0;
  top: 50%;
  left: 37px;
  display: block;
  max-width: 150px;
  overflow: hidden;
  padding: 7px 10px 7px 12px;
  border: 2px solid rgba(255, 255, 255, 0.96);
  border-radius: 0 999px 999px 0;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 7px 8px 18px rgba(32, 55, 79, 0.16);
  text-overflow: ellipsis;
  transform: translateY(-50%);
  pointer-events: auto;
}

.place-marker.edge-right .marker-name {
  right: 37px;
  left: auto;
  padding-right: 12px;
  padding-left: 10px;
  border-radius: 999px 0 0 999px;
  box-shadow: -7px 8px 18px rgba(32, 55, 79, 0.16);
}

.place-marker.selected .marker-name {
  border-color: #fed7aa;
  background: #fffaf4;
  pointer-events: none;
}

.place-marker.in-plan .marker-name {
  border-color: #bfdbfe;
  background: #f7fbff;
}

.place-marker.compact-marker {
  width: 44px;
  max-width: 44px;
  padding: 4px;
}

.place-marker.compact-marker .marker-name {
  display: none;
  pointer-events: none;
}

.place-marker.compact-marker:hover,
.place-marker.compact-marker:focus-visible {
  width: 44px;
  max-width: 44px;
  padding: 4px;
}

.place-marker.compact-marker:hover .marker-name,
.place-marker.compact-marker:focus-visible .marker-name {
  display: inline;
}

.place-marker .plan-index {
  position: absolute;
  top: -9px;
  left: -5px;
  display: grid;
  width: 21px;
  height: 21px;
  place-items: center;
  border: 2px solid #fff;
  border-radius: 50%;
  color: #fff;
  background: var(--brand);
  font-size: 10px;
  font-weight: 950;
}

.map-caption {
  position: absolute;
  z-index: 7;
  left: calc(15px + var(--safe-left));
  bottom: calc(15px + var(--safe-bottom));
  max-width: min(460px, calc(100% - 30px - var(--safe-left) - var(--safe-right)));
  padding: 9px 12px;
  border: 1px solid rgba(255, 255, 255, 0.64);
  border-radius: 14px;
  color: #38536d;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 8px 22px rgba(34, 68, 97, 0.12);
  backdrop-filter: blur(12px);
  font-size: 12px;
  line-height: 1.55;
  pointer-events: none;
}

.add-place-tip {
  position: absolute;
  z-index: 50;
  top: 18px;
  left: 50%;
  display: flex;
  width: max-content;
  transform: translateX(-50%);
  max-width: calc(100% - 32px);
  align-items: center;
  gap: 10px;
  padding: 8px 9px 8px 10px;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 18px;
  color: #fff;
  background: rgba(23, 36, 58, 0.94);
  box-shadow: var(--shadow);
  font-size: 13px;
  font-weight: 850;
  backdrop-filter: blur(14px);
}

.add-place-tip-icon {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 12px;
  color: #173f9b;
  background: linear-gradient(145deg, #fff7c7, #facc15);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.8), 0 5px 12px rgba(0, 0, 0, 0.18);
  font-size: 23px;
}

.add-place-tip-copy {
  display: grid;
  min-width: 0;
  gap: 1px;
  text-align: left;
}

.add-place-tip-copy b,
.add-place-tip-copy small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-place-tip-copy small {
  color: #cbd5e1;
  font-size: 10px;
  font-weight: 700;
}

.add-place-tip button {
  min-height: 40px;
  padding: 7px 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
  font-size: 12px;
  font-weight: 900;
}

.add-place-tip-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 5px;
}

body.add-place-mode .virtual-map {
  cursor: crosshair;
  box-shadow: inset 0 0 0 4px rgba(250, 204, 21, 0.72), inset 0 0 42px rgba(37, 99, 235, 0.13);
}

body.add-place-mode .map-art {
  filter: saturate(0.88) brightness(1.02);
}

body.edit-mode .topbar {
  border-bottom-color: rgba(251, 146, 60, 0.46);
  box-shadow: inset 0 -3px rgba(251, 146, 60, 0.54), 0 8px 28px rgba(51, 75, 101, 0.1);
}

.detail-panel {
  position: absolute;
  z-index: 2200;
  top: 16px;
  right: calc(16px + var(--safe-right));
  bottom: 16px;
  width: min(390px, calc(100% - 32px));
  overflow: auto;
  padding: 20px;
  border: 1px solid rgba(255, 255, 255, 0.78);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: var(--shadow);
  transform: translateX(calc(100% + 36px));
  transition: transform 0.28s ease;
  scrollbar-width: thin;
}

.detail-panel.open {
  transform: translateX(0);
}

.detail-panel.editing {
  width: min(440px, calc(100% - 32px));
  background: rgba(249, 252, 255, 0.985);
}

.panel-close {
  position: sticky;
  z-index: 2;
  top: 0;
  float: right;
  width: 44px;
  min-height: 44px;
  border: 0;
  border-radius: 14px;
  color: #475467;
  background: #f2f4f7;
  font-size: 18px;
  transition: color 0.18s, background 0.18s, transform 0.18s;
}

.place-heading {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding-right: 46px;
}

.place-heading .big-emoji {
  display: grid;
  width: 50px;
  height: 50px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 16px;
  background: var(--marker-color, var(--brand-soft));
  font-size: 26px;
}

.place-heading .big-emoji.text-icon,
.icon-live-preview.text-icon {
  font-size: 16px;
  font-weight: 900;
}

.place-heading h2 {
  margin: 2px 0 5px;
  color: #1e2c3e;
  font-size: 21px;
  line-height: 1.3;
}

.place-type {
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
}

.place-gallery {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  margin: 15px 0;
  overflow: hidden;
  border: 1px solid #d9e8f6;
  border-radius: 18px;
  color: #3d5f7b;
  background: linear-gradient(145deg, #d7f1ff, #fff0d2 55%, #ddf7db);
  font-size: 13px;
  font-weight: 850;
}

.gallery-track {
  display: flex;
  width: 100%;
  height: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  overscroll-behavior-x: contain;
  touch-action: pan-x pan-y;
}

.gallery-track::-webkit-scrollbar {
  display: none;
}

.gallery-track:focus-visible {
  outline: 3px solid rgba(37, 99, 235, 0.55);
  outline-offset: -4px;
}

.gallery-slide,
.gallery-empty {
  position: relative;
  display: grid;
  width: 100%;
  height: 100%;
  flex: 0 0 100%;
  margin: 0;
  overflow: hidden;
  place-items: center;
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

.gallery-slide img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-fallback,
.gallery-empty {
  display: grid;
  gap: 6px;
  place-items: center;
  text-align: center;
}

.preview-fallback strong,
.gallery-empty strong {
  font-size: 34px;
}

.preview-fallback strong.text-icon,
.gallery-empty strong.text-icon {
  font-size: 22px;
}

.gallery-control {
  position: absolute;
  z-index: 3;
  top: 50%;
  display: grid;
  width: 44px;
  min-height: 44px;
  padding: 0;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  color: #fff;
  background: rgba(23, 36, 58, 0.62);
  box-shadow: 0 5px 14px rgba(23, 36, 58, 0.22);
  font-size: 25px;
  transform: translateY(-50%);
  backdrop-filter: blur(8px);
}

.gallery-control.previous {
  left: 8px;
}

.gallery-control.next {
  right: 8px;
}

.gallery-status {
  position: absolute;
  z-index: 3;
  right: 9px;
  bottom: 8px;
  display: flex;
  min-height: 25px;
  align-items: center;
  gap: 6px;
  pointer-events: none;
  padding: 4px 8px;
  border-radius: 999px;
  color: #fff;
  background: rgba(23, 36, 58, 0.66);
  box-shadow: 0 4px 12px rgba(23, 36, 58, 0.18);
  font-size: 10px;
  font-weight: 900;
  backdrop-filter: blur(8px);
}

.gallery-dots {
  display: flex;
  gap: 4px;
}

.gallery-dot {
  display: block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.52);
  transition: width 0.2s, background 0.2s;
}

.gallery-dot.active {
  width: 12px;
  border-radius: 999px;
  background: #fff;
}

.image-add-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
}

.image-edit-list {
  display: grid;
  gap: 8px;
  margin-top: 9px;
}

.image-edit-item {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 7px;
  border: 1px solid #dbe7f2;
  border-radius: 13px;
  background: #f8fbff;
}

.image-edit-item img {
  width: 58px;
  height: 44px;
  border-radius: 9px;
  background: #eaf2ff;
  object-fit: cover;
}

.image-edit-item span {
  overflow: hidden;
  color: #5b6678;
  font-size: 11px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.image-edit-item button {
  min-height: 44px;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin: 12px 0;
}

.info-item {
  min-width: 0;
  padding: 10px;
  border-radius: 13px;
  background: #f6f8fb;
}

.info-item b {
  display: block;
  margin-bottom: 4px;
  color: var(--muted);
  font-size: 11px;
}

.info-item span {
  display: block;
  overflow-wrap: anywhere;
  font-size: 13px;
  font-weight: 750;
  line-height: 1.45;
}

.section-title {
  margin: 16px 0 7px;
  color: #344054;
  font-size: 13px;
  font-weight: 950;
}

.description {
  color: #475467;
  font-size: 13px;
  line-height: 1.72;
  white-space: pre-wrap;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.tag {
  padding: 5px 9px;
  border-radius: 999px;
  color: #335a8f;
  background: #edf5ff;
  font-size: 11px;
  font-weight: 800;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.btn,
.btn-primary,
.btn-danger,
.btn-soft {
  min-height: 44px;
  padding: 9px 13px;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: #344054;
  background: #fff;
  font-weight: 850;
  transition: border-color 0.18s, box-shadow 0.18s, color 0.18s, background 0.18s, transform 0.18s;
}

.btn-primary {
  border-color: var(--brand);
  color: #fff;
  background: var(--brand);
}

.btn-soft {
  border-color: #bfdbfe;
  color: #1747b8;
  background: #eff6ff;
}

.btn-danger {
  border-color: #fecaca;
  color: #b42318;
  background: #fff7f7;
}

.btn:disabled,
.btn-primary:disabled,
.btn-danger:disabled,
input:disabled,
select:disabled,
textarea:disabled {
  cursor: not-allowed;
  opacity: 0.53;
}

[aria-disabled="true"] {
  cursor: not-allowed !important;
  opacity: 0.53;
}

.plan-state {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 6px 10px;
  border-radius: 999px;
  color: #1747b8;
  background: #eaf2ff;
  font-size: 12px;
  font-weight: 900;
}

.field {
  margin: 11px 0;
}

.field label {
  display: block;
  margin-bottom: 6px;
  color: #344054;
  font-size: 12px;
  font-weight: 850;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  min-height: 44px;
  padding: 10px 11px;
  border: 1px solid #d9dee7;
  border-radius: 11px;
  color: #344054;
  background: #fbfcfe;
  transition: border-color 0.18s, background 0.18s, box-shadow 0.18s;
}

.field textarea {
  min-height: 84px;
  resize: vertical;
}

.grid-two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.edit-note,
.hint {
  padding: 10px 12px;
  border-radius: 12px;
  color: #5b6678;
  background: #f6f8fb;
  font-size: 12px;
  line-height: 1.65;
}

.editor-banner {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  margin: 16px 0 12px;
  padding: 11px 12px;
  border: 1px solid #bfdbfe;
  border-radius: 17px;
  color: #193b72;
  background: linear-gradient(135deg, #eff6ff, #fff 58%, #fff7ed);
  box-shadow: 0 8px 22px rgba(37, 99, 235, 0.08);
}

.editor-banner-mark {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 12px;
  color: #fff;
  background: linear-gradient(145deg, #60a5fa, #2563eb);
  box-shadow: 0 7px 14px rgba(37, 99, 235, 0.24);
  font-size: 18px;
}

.editor-banner div,
.editor-section-title div,
.danger-zone div,
.editor-empty-state div {
  display: grid;
  min-width: 0;
  gap: 2px;
}

.editor-banner b,
.editor-section-title b,
.danger-zone b,
.editor-empty-state b {
  font-size: 13px;
}

.editor-banner small,
.editor-section-title small,
.danger-zone small,
.editor-empty-state small {
  color: #667085;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.45;
}

.autosave-badge,
.section-count {
  display: inline-flex;
  min-height: 27px;
  align-items: center;
  justify-content: center;
  padding: 5px 8px;
  border-radius: 999px;
  color: #166534;
  background: #dcfce7;
  font-size: 10px;
  font-weight: 900;
  white-space: nowrap;
}

.autosave-badge::before {
  width: 6px;
  height: 6px;
  margin-right: 5px;
  border-radius: 50%;
  background: #22c55e;
  content: "";
}

.editor-section {
  margin: 11px 0;
  padding: 13px;
  border: 1px solid #e1eaf4;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 7px 20px rgba(47, 72, 101, 0.055);
}

.editor-section-title {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  margin-bottom: 10px;
}

.editor-section-title > span:first-child {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 9px;
  color: #25539c;
  background: #eaf2ff;
  font-size: 9px;
  font-weight: 950;
}

.editor-section .field:first-of-type {
  margin-top: 8px;
}

.icon-live-preview {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 2px solid #fff;
  border-radius: 15px;
  background: var(--marker-color, var(--brand-soft));
  box-shadow: 0 6px 15px rgba(36, 54, 74, 0.16);
  font-size: 23px;
}

.icon-auto-choice {
  display: grid;
  width: 100%;
  min-height: 52px;
  grid-template-columns: 40px minmax(0, 1fr);
  grid-template-rows: auto auto;
  align-items: center;
  gap: 0 9px;
  padding: 7px 10px;
  border: 1px solid #dbe7f2;
  border-radius: 14px;
  color: #344054;
  background: #f8fbff;
  text-align: left;
}

.icon-auto-choice > span {
  display: grid;
  width: 40px;
  height: 40px;
  grid-row: 1 / 3;
  place-items: center;
  border-radius: 12px;
  background: #fff;
  font-size: 21px;
}

.icon-auto-choice b {
  align-self: end;
  font-size: 12px;
}

.icon-auto-choice small {
  align-self: start;
  color: #667085;
  font-size: 10px;
}

.icon-auto-choice.active,
.icon-choice.active {
  border-color: #60a5fa;
  background: #eff6ff;
  box-shadow: inset 0 0 0 1px #93c5fd, 0 5px 14px rgba(37, 99, 235, 0.12);
}

.icon-choice-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(44px, 1fr));
  gap: 7px;
  margin-top: 9px;
}

.icon-choice {
  display: grid;
  min-width: 44px;
  min-height: 48px;
  padding: 0;
  place-items: center;
  border: 1px solid #dbe7f2;
  border-radius: 13px;
  color: #27364a;
  background: #fff;
  font-size: 22px;
  transition: border-color 0.18s, box-shadow 0.18s, background 0.18s, transform 0.18s;
}

.icon-custom-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 8px;
  margin-top: 4px;
}

.icon-custom-row .field {
  margin-bottom: 0;
}

.icon-custom-row input {
  font-size: 17px;
}

.field-help {
  margin: 6px 0 0;
  color: #667085;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.5;
}

.section-count {
  color: #25539c;
  background: #eaf2ff;
}

.editor-empty-state {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  padding: 12px;
  border: 1px dashed #c8d8e8;
  border-radius: 14px;
  color: #475467;
  background: #f8fbff;
}

.editor-empty-state > span {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border-radius: 12px;
  background: #eaf2ff;
  font-size: 20px;
}

.danger-zone {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
  padding: 10px;
  border: 1px solid #fee2e2;
  border-radius: 14px;
  background: #fffafa;
}

#imageUpload::file-selector-button {
  min-height: 34px;
  margin-right: 8px;
  padding: 6px 10px;
  border: 0;
  border-radius: 9px;
  color: #1747b8;
  background: #eaf2ff;
  font-weight: 850;
  cursor: pointer;
}

@media (hover: hover) {
  .btn:hover:not(:disabled),
  .btn-primary:hover:not(:disabled),
  .btn-danger:hover:not(:disabled),
  .btn-soft:hover:not(:disabled),
  .icon-choice:hover,
  .icon-auto-choice:hover,
  .add-place-tip button:hover {
    transform: translateY(-1px);
    box-shadow: 0 7px 16px rgba(36, 54, 74, 0.14);
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--brand-dark);
  }

  .panel-close:hover {
    color: #1747b8;
    background: #eaf2ff;
    transform: rotate(2deg);
  }

  .field input:hover:not(:disabled),
  .field select:hover:not(:disabled),
  .field textarea:hover:not(:disabled) {
    border-color: #b9cce0;
    background: #fff;
  }
}

.btn:active:not(:disabled),
.btn-primary:active:not(:disabled),
.btn-danger:active:not(:disabled),
.btn-soft:active:not(:disabled),
.icon-choice:active,
.icon-auto-choice:active {
  transform: translateY(1px) scale(0.99);
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: #60a5fa;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.09);
}

.floating-mascot {
  position: fixed;
  z-index: 2500;
  width: 72px;
  height: 118px;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 0;
  color: transparent;
  background: transparent;
  filter: none;
  touch-action: none;
  user-select: none;
  cursor: grab;
}

.floating-mascot:active,
.floating-mascot.dragging {
  cursor: grabbing;
}

.floating-mascot:focus-visible {
  outline: 0;
}

.floating-mascot:focus-visible img {
  filter: drop-shadow(0 1px 1px rgba(255, 255, 255, 0.92)) drop-shadow(0 10px 10px rgba(23, 47, 78, 0.28)) drop-shadow(0 0 4px rgba(37, 99, 235, 0.92));
}

.floating-mascot::after {
  position: absolute;
  z-index: -1;
  right: 11px;
  bottom: 2px;
  left: 11px;
  height: 10px;
  border-radius: 50%;
  background: rgba(24, 55, 88, 0.22);
  filter: blur(5px);
  content: "";
  pointer-events: none;
}

.floating-mascot img {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  border-radius: 0;
  object-fit: contain;
  object-position: center;
  filter: drop-shadow(0 1px 1px rgba(255, 255, 255, 0.92)) drop-shadow(0 10px 10px rgba(23, 47, 78, 0.28));
  pointer-events: none;
  transform-style: preserve-3d;
  will-change: transform;
  animation: mascotFloat 3.1s ease-in-out infinite, mascotBreathe 4.6s ease-in-out infinite;
}

.floating-mascot.dragging img {
  animation-play-state: paused;
}

.mascot-tip {
  position: absolute;
  top: 2px;
  right: 69px;
  width: max-content;
  max-width: 150px;
  padding: 6px 9px;
  border: 1px solid #dbeafe;
  border-radius: 11px 11px 3px 11px;
  color: #35516e;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6px 16px rgba(37, 58, 81, 0.15);
  font-size: 11px;
  font-weight: 800;
  pointer-events: none;
  opacity: 0;
  transform: translateX(5px);
  transition: 0.2s;
}

.floating-mascot:hover .mascot-tip,
.floating-mascot:focus-visible .mascot-tip {
  opacity: 1;
  transform: translateX(0);
}

@keyframes mascotFloat {
  0%,
  100% {
    transform: translateY(0) rotateY(-3deg) rotateZ(-1deg);
  }
  50% {
    transform: translateY(-5px) rotateY(5deg) rotateZ(1.2deg);
  }
}

@keyframes mascotBreathe {
  0%,
  100% {
    scale: 1;
  }
  50% {
    scale: 1.018;
  }
}

.settings-backdrop,
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 3000;
  visibility: hidden;
  background: rgba(18, 31, 49, 0.5);
  opacity: 0;
  transition: opacity 0.23s, visibility 0.23s;
}

.settings-backdrop.open,
.modal-backdrop.open {
  visibility: visible;
  opacity: 1;
}

.settings-drawer {
  position: absolute;
  top: 0;
  right: 0;
  width: min(470px, 96vw);
  height: 100%;
  overflow-y: auto;
  padding: calc(22px + var(--safe-top)) calc(22px + var(--safe-right)) calc(22px + var(--safe-bottom)) calc(22px + var(--safe-left));
  background: #fff;
  box-shadow: -24px 0 70px rgba(18, 31, 49, 0.23);
  transform: translateX(102%);
  transition: transform 0.28s ease;
}

.settings-backdrop.open .settings-drawer {
  transform: translateX(0);
}

.drawer-head {
  position: sticky;
  z-index: 5;
  top: calc(-22px - var(--safe-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: calc(-22px - var(--safe-top)) -22px 0;
  padding: calc(17px + var(--safe-top)) 22px 17px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(14px);
}

.drawer-head h2 {
  margin: 0;
  font-size: 20px;
}

.settings-brand {
  display: grid;
  grid-template-columns: 72px 1fr;
  align-items: center;
  gap: 13px;
  margin: 18px 0;
  padding: 13px;
  border: 1px solid #dbeafe;
  border-radius: 18px;
  background: linear-gradient(135deg, #f7fbff, #fff8ec);
}

.settings-mascot {
  display: grid;
  width: 72px;
  height: 72px;
  overflow: hidden;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.92);
  border-radius: 20px;
  background: radial-gradient(circle at 45% 34%, #fff 0 25%, #dff2ff 63%, #bfdcff 100%);
  box-shadow: inset 0 1px 0 #fff, 0 8px 18px rgba(37, 99, 235, 0.16);
}

.settings-mascot img {
  width: 72px;
  height: 72px;
  object-fit: contain;
  filter: drop-shadow(0 5px 5px rgba(36, 62, 92, 0.2));
  pointer-events: none;
}

.settings-brand strong {
  display: block;
  color: var(--brand);
  font-size: 24px;
  letter-spacing: 0.3px;
}

.settings-brand p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.55;
}

.settings-section {
  padding: 17px 0;
  border-top: 1px solid var(--line);
}

.settings-section h3 {
  margin: 0 0 10px;
  color: #26364a;
  font-size: 15px;
}

.mode-card {
  padding: 14px;
  border: 1px solid #dbeafe;
  border-radius: 17px;
  background: #f7fbff;
}

.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.mode-row b {
  color: #24364c;
  font-size: 14px;
}

.mode-badge {
  padding: 6px 9px;
  border-radius: 999px;
  color: #38536d;
  background: #e7edf4;
  font-size: 11px;
  font-weight: 900;
}

.mode-badge.editing {
  color: #08764b;
  background: #dff8eb;
}

.unlock-row {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

.unlock-row .field {
  flex: 1;
  margin: 0;
}

.error {
  min-height: 20px;
  margin-top: 6px;
  color: #b42318;
  font-size: 12px;
}

.city-list {
  display: grid;
  gap: 8px;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 11px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: #fff;
}

.city-item.current {
  border-color: #93c5fd;
  background: #eff6ff;
}

.city-meta {
  margin-top: 3px;
  color: var(--muted);
  font-size: 11px;
}

.version-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}

.modal-backdrop {
  display: grid;
  place-items: center;
  padding: 16px calc(16px + var(--safe-right)) calc(16px + var(--safe-bottom)) calc(16px + var(--safe-left));
}

.modal {
  width: min(470px, 96vw);
  max-height: 90vh;
  overflow-y: auto;
  padding: 20px;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 28px 90px rgba(18, 31, 49, 0.28);
  transform: translateY(16px) scale(0.98);
  transition: transform 0.23s;
}

.modal-backdrop.open .modal {
  transform: translateY(0) scale(1);
}

.modal h2 {
  margin: 0 0 5px;
  font-size: 19px;
}

.route-drawer {
  position: fixed;
  z-index: 2000;
  left: calc(12px + var(--safe-left));
  right: calc(12px + var(--safe-right));
  bottom: calc(10px + var(--safe-bottom));
  height: min(340px, 43vh);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.82);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -10px 50px rgba(29, 49, 70, 0.22);
  transform: translateY(0);
  transition: height 0.3s ease, transform 0.3s ease, opacity 0.2s;
  backdrop-filter: blur(18px);
}

.route-drawer.collapsed {
  height: 64px;
}

.route-drawer.is-hidden {
  visibility: hidden;
  opacity: 0;
  transform: translateY(calc(100% + 26px));
  pointer-events: none;
}

.route-handle {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 12px;
  width: 100%;
  height: 64px;
  padding: 10px 18px;
  border: 0;
  border-bottom: 1px solid var(--line);
  color: #26364a;
  background: transparent;
  text-align: left;
  touch-action: none;
}

.handle-copy {
  min-width: 0;
}

.handle-copy strong {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 15px;
  white-space: nowrap;
}

.route-summary {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: var(--muted);
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.handle-chevron {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 13px;
  color: var(--brand-dark);
  background: var(--brand-soft);
  font-size: 18px;
  transition: transform 0.28s;
}

.route-drawer:not(.collapsed) .handle-chevron {
  transform: rotate(180deg);
}

.route-content {
  height: calc(100% - 64px);
  overflow: hidden;
  padding: 13px 16px 17px;
  opacity: 1;
  transition: opacity 0.18s;
}

.route-drawer.collapsed .route-content {
  opacity: 0;
  pointer-events: none;
}

.timeline {
  display: flex;
  height: 100%;
  align-items: stretch;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 2px 2px 10px;
  scroll-snap-type: x proximity;
  overscroll-behavior-x: contain;
}

.timeline::-webkit-scrollbar {
  height: 8px;
}

.timeline::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: #c9d4e1;
}

.route-node {
  position: relative;
  min-width: 220px;
  max-width: 220px;
  padding: 13px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: #fff;
  scroll-snap-align: start;
}

.route-node.selected {
  border-color: var(--brand);
  box-shadow: 0 9px 22px rgba(37, 99, 235, 0.14);
}

.route-node-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.route-number,
.route-type {
  font-size: 11px;
  font-weight: 900;
}

.route-number {
  color: var(--brand);
}

.route-type {
  padding: 5px 8px;
  border-radius: 999px;
  color: #475467;
  background: #f2f4f7;
}

.route-node h3 {
  margin: 12px 0 5px;
  overflow: hidden;
  color: #25364b;
  font-size: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-node p {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.node-actions {
  display: flex;
  gap: 5px;
  margin-top: 10px;
}

.node-actions button {
  min-height: 44px;
  padding: 5px 8px;
  border: 1px solid var(--line);
  border-radius: 9px;
  color: #42526a;
  background: #fff;
  font-size: 11px;
  font-weight: 800;
}

.route-edge {
  display: flex;
  min-width: 148px;
  max-width: 148px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 9px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.45;
  text-align: center;
}

.route-edge.editable {
  cursor: pointer;
}

.route-edge b {
  color: #344054;
  font-size: 12px;
}

.edge-line {
  position: relative;
  width: 100%;
  height: 3px;
  margin: 9px 0;
  border-radius: 999px;
  background: repeating-linear-gradient(90deg, var(--brand) 0 8px, transparent 8px 13px);
}

.edge-line::after {
  position: absolute;
  top: -5px;
  right: -1px;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
  border-left: 8px solid var(--orange);
  content: "";
}

.toast {
  position: fixed;
  z-index: 5000;
  left: 50%;
  bottom: 86px;
  max-width: calc(100vw - 28px);
  padding: 10px 14px;
  border-radius: 999px;
  color: #fff;
  background: #17243a;
  box-shadow: 0 12px 30px rgba(18, 31, 49, 0.25);
  font-size: 12px;
  font-weight: 800;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 14px);
  transition: 0.23s;
}

.toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}

@media (max-width: 1120px) {
  .topbar {
    grid-template-columns: auto auto minmax(180px, 1fr);
    padding-right: 94px;
  }

  .filter-strip {
    grid-column: 1 / -1;
    max-width: none;
  }

  :root {
    --header-height: 124px;
  }
}

@media (max-width: 720px) {
  :root {
    --header-height: 132px;
  }

  .topbar {
    grid-template-columns: auto minmax(0, 1fr);
    gap: 7px;
    min-height: calc(var(--header-height) + var(--safe-top));
    padding: calc(7px + var(--safe-top)) calc(75px + var(--safe-right)) 7px calc(9px + var(--safe-left));
  }

  .brand-logo-wrap {
    width: 121px;
    min-height: 44px;
  }

  .brand-logo-3d {
    width: 119px;
    height: 40px;
    gap: 5px;
  }

  .brand-emblem {
    width: 34px;
    height: 31px;
    border-radius: 11px 11px 13px 13px;
    box-shadow: inset 2px 2px 5px rgba(255, 255, 255, 0.45), inset -3px -4px 6px rgba(5, 49, 135, 0.3), 0 3px 0 #103d98, 0 5px 9px rgba(21, 84, 182, 0.22);
  }

  .brand-emblem-text {
    font-size: 17px;
  }

  .brand-smile {
    right: 6px;
    bottom: 4px;
    left: 6px;
    height: 7px;
    border-bottom-width: 2px;
  }

  .brand-pin {
    top: -6px;
    right: -4px;
    width: 11px;
    height: 11px;
  }

  .brand-pin::after {
    top: 2px;
    left: 2px;
    width: 3px;
    height: 3px;
  }

  .brand-wordmark {
    font-size: 21px;
    letter-spacing: -1.4px;
  }

  .current-city {
    justify-self: end;
    max-width: 125px;
    min-height: 38px;
    overflow: hidden;
    padding: 6px 10px;
    font-size: 12px;
    text-overflow: ellipsis;
  }

  .search-box {
    grid-column: 1 / -1;
    height: 43px;
  }

  .filter-strip {
    grid-column: 1 / -1;
  }

  .filter-chip {
    min-height: 44px;
  }

  .map-caption {
    bottom: calc(11px + var(--safe-bottom));
    left: calc(10px + var(--safe-left));
    max-width: calc(100% - 20px - var(--safe-left) - var(--safe-right));
    padding: 7px 9px;
    font-size: 10px;
  }

  .place-marker {
    width: 44px;
    height: 44px;
    min-height: 44px;
    max-width: 44px;
    padding: 4px;
    font-size: 10px;
  }

  .place-marker .marker-name {
    max-width: 118px;
    padding: 6px 8px 6px 10px;
  }

  .place-marker .marker-emoji {
    width: 29px;
    height: 29px;
    font-size: 17px;
  }

  .place-marker .marker-emoji.text-icon {
    font-size: 11px;
  }

  .detail-panel {
    top: auto;
    right: calc(8px + var(--safe-right));
    bottom: calc(8px + var(--safe-bottom));
    left: calc(8px + var(--safe-left));
    width: auto;
    max-height: calc(100dvh - var(--header-height) - var(--safe-top) - var(--safe-bottom) - 130px);
    border-radius: 24px;
    transform: translateY(calc(100% + 24px));
  }

  .detail-panel.editing {
    width: auto;
    padding: 14px;
  }

  .detail-panel.open {
    transform: translateY(0);
  }

  .detail-panel.route-visible {
    bottom: calc(78px + var(--safe-bottom));
    max-height: calc(100dvh - var(--header-height) - var(--safe-top) - var(--safe-bottom) - 200px);
  }

  .floating-mascot {
    width: 62px;
    height: 102px;
  }

  .mascot-tip {
    display: none;
  }

  .settings-drawer {
    width: 100vw;
    padding: calc(18px + var(--safe-top)) calc(18px + var(--safe-right)) calc(18px + var(--safe-bottom)) calc(18px + var(--safe-left));
  }

  .drawer-head {
    top: calc(-18px - var(--safe-top));
    margin: calc(-18px - var(--safe-top)) -18px 0;
    padding: calc(14px + var(--safe-top)) 18px 14px;
  }

  .route-drawer {
    right: calc(7px + var(--safe-right));
    bottom: calc(6px + var(--safe-bottom));
    left: calc(7px + var(--safe-left));
    height: min(390px, 52vh);
    border-radius: 22px;
  }

  .route-drawer.collapsed {
    height: 62px;
  }

  .route-handle {
    height: 62px;
    padding: 9px 13px;
  }

  .route-content {
    height: calc(100% - 62px);
    padding: 11px 11px 14px;
  }

  .route-node {
    min-width: 72vw;
    max-width: 72vw;
  }

  .route-edge {
    min-width: 128px;
    max-width: 128px;
  }

  .info-grid,
  .grid-two {
    grid-template-columns: 1fr;
  }

  .unlock-row,
  .version-row {
    grid-template-columns: 1fr;
  }

  .unlock-row {
    display: grid;
  }

  .add-place-tip {
    top: 10px;
    width: calc(100% - 20px - var(--safe-left) - var(--safe-right));
    max-width: 420px;
    gap: 8px;
    padding: 7px;
    font-size: 11px;
  }

  .add-place-tip-copy {
    flex: 1;
  }

  .add-place-tip button {
    flex: 0 0 auto;
  }

  .editor-section {
    padding: 11px;
  }

  .icon-choice-grid {
    grid-template-columns: repeat(4, minmax(44px, 1fr));
  }

  .icon-custom-row,
  .danger-zone {
    grid-template-columns: 1fr;
  }

  .icon-custom-row .btn-soft,
  .danger-zone .btn-danger {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

@media (forced-colors: active) {
  .brand-emblem,
  .brand-pin {
    border: 2px solid LinkText;
    color: LinkText;
    background: Canvas;
    box-shadow: none;
  }

  .brand-wordmark span,
  .brand-wordmark b {
    color: LinkText;
    text-shadow: none;
  }

  .floating-mascot:focus-visible {
    outline: 2px solid ButtonText;
    outline-offset: 2px;
    border-radius: 45%;
  }
}

/* v4 editor polish: visible edit controls and guided place creation. */
.edit-toolbar {
  position: absolute;
  z-index: 52;
  top: 16px;
  left: 16px;
  display: flex;
  max-width: calc(100% - 32px);
  align-items: center;
  gap: 12px;
  padding: 9px 10px;
  border: 1px solid rgba(255, 255, 255, 0.76);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14px 35px rgba(35, 58, 83, 0.19);
  backdrop-filter: blur(16px);
}

.edit-toolbar-status {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
}

.edit-toolbar-status > span:first-child {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 12px;
  color: #fff;
  background: linear-gradient(145deg, #fb923c, #f97316);
  box-shadow: 0 7px 15px rgba(234, 88, 12, 0.24);
  font-size: 17px;
}

.edit-toolbar-status > span:last-child {
  display: grid;
  min-width: 0;
  gap: 1px;
}

.edit-toolbar-status b {
  color: #7c2d12;
  font-size: 12px;
}

.edit-toolbar-status small {
  overflow: hidden;
  color: #667085;
  font-size: 10px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-toolbar-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 7px;
}

.edit-toolbar-actions .btn,
.edit-toolbar-actions .btn-primary {
  min-height: 40px;
  padding: 7px 11px;
  font-size: 11px;
}

.add-place-modal {
  width: min(650px, 96vw);
  padding: 22px;
}

.modal-heading-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: 14px;
}

.modal-heading-row h2 {
  margin: 2px 0 5px;
  font-size: 22px;
}

.modal-heading-row .description {
  margin: 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.65;
}

.modal-kicker {
  color: #2563eb;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: 0.12em;
}

.add-place-preview {
  display: grid;
  width: 68px;
  height: 68px;
  place-items: center;
  border: 3px solid #fff;
  border-radius: 22px;
  background: var(--marker-color, #fce7d6);
  box-shadow: 0 12px 28px rgba(36, 54, 74, 0.19);
  font-size: 34px;
}

.add-place-preview.text-icon {
  font-size: 21px;
  font-weight: 950;
}

.choice-fieldset {
  min-width: 0;
  margin: 15px 0 0;
  padding: 12px;
  border: 1px solid #e1eaf4;
  border-radius: 18px;
  background: #fbfdff;
}

.choice-fieldset legend {
  padding: 0 6px;
  color: #344054;
  font-size: 12px;
  font-weight: 900;
}

.type-choice-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.type-choice {
  display: grid;
  min-width: 0;
  min-height: 72px;
  grid-template-columns: 36px minmax(0, 1fr);
  align-items: center;
  gap: 7px;
  padding: 8px;
  border: 1px solid #dbe7f2;
  border-radius: 14px;
  color: #344054;
  background: #fff;
  text-align: left;
  transition: border-color 0.18s, background 0.18s, box-shadow 0.18s, transform 0.18s;
}

.type-choice > span {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 12px;
  background: var(--type-color, #eaf2ff);
  font-size: 20px;
}

.type-choice b {
  overflow: hidden;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-choice.active {
  border-color: #60a5fa;
  background: #eff6ff;
  box-shadow: inset 0 0 0 1px #93c5fd, 0 6px 15px rgba(37, 99, 235, 0.12);
}

.add-place-icon-grid {
  grid-template-columns: repeat(8, minmax(44px, 1fr));
}

.new-place-location-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 13px;
  padding: 10px 12px;
  border: 1px solid #dbeafe;
  border-radius: 13px;
  color: #38536d;
  background: #f3f8ff;
  font-size: 11px;
  line-height: 1.55;
}

.new-place-location-note b {
  color: #1747b8;
}

.modal-actions {
  justify-content: flex-end;
  padding-top: 2px;
}

@media (hover: hover) {
  .type-choice:hover {
    border-color: #93c5fd;
    background: #f8fbff;
    transform: translateY(-1px);
  }
}

@media (max-width: 720px) {
  .edit-toolbar {
    top: 9px;
    left: 9px;
    right: 9px;
    max-width: none;
    justify-content: space-between;
    gap: 8px;
    padding: 7px;
  }

  .edit-toolbar-status small {
    display: none;
  }

  .edit-toolbar-status > span:first-child {
    width: 32px;
    height: 32px;
  }

  .edit-toolbar-actions .btn,
  .edit-toolbar-actions .btn-primary {
    min-height: 38px;
    padding: 6px 9px;
  }

  .add-place-modal {
    width: 100%;
    max-height: calc(100dvh - 20px - var(--safe-top) - var(--safe-bottom));
    padding: 17px;
    border-radius: 22px;
  }

  .add-place-preview {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    font-size: 29px;
  }

  .type-choice-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .type-choice {
    min-height: 58px;
  }

  .add-place-icon-grid {
    grid-template-columns: repeat(4, minmax(44px, 1fr));
  }

  .modal-actions .btn,
  .modal-actions .btn-primary {
    flex: 1 1 150px;
  }
}


/* v5 mobile map viewport, gesture zoom and collapsible navigation. */
.topbar-toggle {
  position: fixed;
  z-index: 1305;
  top: calc(12px + var(--safe-top));
  right: calc(12px + var(--safe-right));
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 7px 10px;
  border: 1px solid rgba(37, 99, 235, 0.2);
  border-radius: 14px;
  color: var(--brand-dark);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8px 24px rgba(34, 67, 105, 0.16);
  font-size: 11px;
  font-weight: 900;
  backdrop-filter: blur(14px);
}

.topbar-toggle-icon {
  font-size: 15px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.app-shell.nav-collapsed {
  grid-template-rows: minmax(0, 1fr);
}

.app-shell.nav-collapsed .topbar {
  display: none;
}

.app-shell.nav-collapsed .topbar-toggle {
  top: calc(8px + var(--safe-top));
  padding-inline: 11px;
  color: #fff;
  border-color: rgba(255, 255, 255, 0.68);
  background: rgba(23, 71, 184, 0.93);
}

.app-shell.nav-collapsed .topbar-toggle-icon {
  transform: rotate(180deg);
}

.map-transform-layer {
  position: absolute;
  z-index: 1;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: translate3d(0, 0, 0) scale(1);
  transform-origin: 0 0;
  will-change: transform;
}

.map-zoom-controls {
  position: absolute;
  z-index: 48;
  right: calc(12px + var(--safe-right));
  top: 50%;
  display: grid;
  gap: 6px;
  transform: translateY(-50%);
}

.map-zoom-controls button {
  display: grid;
  width: 46px;
  min-height: 46px;
  padding: 0;
  place-items: center;
  border: 1px solid rgba(32, 78, 182, 0.2);
  border-radius: 15px;
  color: #1747b8;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 9px 24px rgba(31, 61, 93, 0.18);
  font-size: 23px;
  font-weight: 950;
  backdrop-filter: blur(12px);
}

.map-zoom-controls button:last-child {
  font-size: 11px;
}

.map-gesture-hint {
  position: absolute;
  z-index: 47;
  top: 15px;
  left: 50%;
  display: inline-flex;
  min-height: 36px;
  align-items: center;
  gap: 6px;
  padding: 7px 10px;
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 999px;
  color: #38536d;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8px 22px rgba(35, 58, 83, 0.14);
  font-size: 11px;
  font-weight: 850;
  pointer-events: none;
  transform: translateX(-50%);
  transition: opacity 0.25s ease, transform 0.25s ease;
  backdrop-filter: blur(12px);
}

.map-gesture-hint.dismissed {
  opacity: 0;
  transform: translate(-50%, -8px);
}

.virtual-map {
  touch-action: none;
  overscroll-behavior: none;
}

.virtual-map.is-panning {
  cursor: grabbing;
}

.virtual-map:not(.is-panning) {
  cursor: grab;
}

.map-transform-layer .place-marker {
  transform: translate(calc(-50% + var(--marker-nudge-x, 0px)), calc(-50% + var(--marker-nudge-y, 0px))) scale(var(--marker-view-scale, 1));
}

.map-transform-layer .place-marker:hover,
.map-transform-layer .place-marker.selected {
  transform: translate(calc(-50% + var(--marker-nudge-x, 0px)), calc(-50% + var(--marker-nudge-y, 0px))) scale(calc(var(--marker-view-scale, 1) * 1.06));
}

.map-transform-layer .place-marker.dragging {
  transform: translate(calc(-50% + var(--marker-nudge-x, 0px)), calc(-50% + var(--marker-nudge-y, 0px))) scale(calc(var(--marker-view-scale, 1) * 1.08)) rotate(-1deg);
}

@media (max-width: 720px) {
  :root {
    --header-height: 101px;
  }

  .topbar {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-rows: 40px 43px;
    gap: 6px 7px;
    min-height: calc(var(--header-height) + var(--safe-top));
    padding: calc(6px + var(--safe-top)) calc(58px + var(--safe-right)) 6px calc(8px + var(--safe-left));
  }

  .brand-logo-wrap {
    grid-column: 1;
    grid-row: 1;
  }

  .current-city {
    grid-column: 2;
    grid-row: 1;
    justify-self: stretch;
    max-width: none;
    min-width: 0;
    justify-content: center;
  }

  .search-box {
    grid-column: 1;
    grid-row: 2;
    height: 43px;
    padding-inline: 10px;
  }

  .search-box input::placeholder {
    font-size: 11px;
  }

  .filter-strip {
    grid-column: 2;
    grid-row: 2;
    align-items: center;
    max-width: none;
    padding: 0 1px;
  }

  .filter-chip {
    min-height: 38px;
    padding: 6px 10px;
  }

  .topbar-toggle {
    top: calc(6px + var(--safe-top));
    right: calc(6px + var(--safe-right));
    width: 46px;
    min-height: 40px;
    padding: 4px;
    border-radius: 13px;
  }

  .topbar-toggle-text {
    display: none;
  }

  .map-zoom-controls {
    right: calc(8px + var(--safe-right));
  }

  .map-zoom-controls button {
    width: 42px;
    min-height: 42px;
    border-radius: 13px;
  }

  .map-gesture-hint {
    top: auto;
    bottom: calc(46px + var(--safe-bottom));
    max-width: calc(100% - 120px);
    white-space: nowrap;
  }

  body.edit-mode .map-gesture-hint,
  body.add-place-mode .map-gesture-hint {
    display: none;
  }

  .map-caption {
    right: calc(58px + var(--safe-right));
    max-width: none;
  }

  .place-marker .marker-name {
    display: none;
  }

  .place-marker.selected .marker-name,
  .place-marker.in-plan .marker-name {
    display: block;
  }

  .app-shell.nav-collapsed .detail-panel {
    max-height: calc(100dvh - var(--safe-top) - var(--safe-bottom) - 130px);
  }

  .app-shell.nav-collapsed .detail-panel.route-visible {
    max-height: calc(100dvh - var(--safe-top) - var(--safe-bottom) - 200px);
  }
}

/* v6 mobile-first navigation, quick city switcher and multi-route planning. */
.city-switcher {
  position: relative;
  min-width: 0;
}

.current-city {
  width: 100%;
  border: 1px solid #dbeafe;
  font: inherit;
}

.city-chevron {
  margin-left: 1px;
  color: #5d7aa0;
  font-size: 13px;
  transition: transform 0.2s ease;
}

.current-city[aria-expanded="true"] .city-chevron {
  transform: rotate(180deg);
}

.city-popover {
  position: absolute;
  z-index: 1400;
  top: calc(100% + 10px);
  left: 0;
  display: grid;
  width: min(290px, calc(100vw - 24px));
  max-height: min(430px, 70vh);
  gap: 5px;
  overflow-y: auto;
  padding: 8px;
  border: 1px solid rgba(86, 119, 155, 0.18);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 20px 55px rgba(28, 50, 77, 0.24);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-7px) scale(0.98);
  transform-origin: top left;
  transition: opacity 0.18s ease, transform 0.18s ease;
  backdrop-filter: blur(18px);
}

.city-popover.open {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}

.quick-city-option {
  display: flex;
  width: 100%;
  min-height: 54px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 11px;
  border: 1px solid transparent;
  border-radius: 13px;
  color: #34445a;
  background: transparent;
  text-align: left;
}

.quick-city-option > span:first-child {
  display: grid;
  min-width: 0;
  gap: 3px;
}

.quick-city-option b,
.quick-city-option small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-city-option small {
  color: var(--muted);
  font-size: 10px;
}

.quick-city-option.current {
  border-color: #bfdbfe;
  color: #1747b8;
  background: #eff6ff;
}

.search-shell {
  position: relative;
  min-width: 0;
}

.search-shell .search-box {
  width: 100%;
}

.search-toggle {
  display: none;
  width: 42px;
  min-height: 42px;
  padding: 0;
  place-items: center;
  border: 1px solid #dbeafe;
  border-radius: 13px;
  color: #1747b8;
  background: #f5f9ff;
  font-size: 18px;
  font-weight: 900;
}

.route-header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  height: 64px;
  border-bottom: 1px solid var(--line);
}

.route-header .route-handle {
  min-width: 0;
  border-bottom: 0;
}

.route-create-button {
  min-height: 42px;
  margin-right: 11px;
  padding: 7px 12px;
  border: 1px solid #bfdbfe;
  border-radius: 13px;
  color: #1747b8;
  background: #eff6ff;
  font-size: 12px;
  font-weight: 950;
  white-space: nowrap;
}

.route-plan-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 11px;
}

.route-plan-tabs {
  display: flex;
  min-width: 0;
  flex: 1;
  gap: 7px;
  overflow-x: auto;
  padding: 2px;
  scrollbar-width: none;
}

.route-plan-tabs::-webkit-scrollbar {
  display: none;
}

.route-plan-tab {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: #506176;
  background: #fff;
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
}

.route-plan-tab small {
  display: grid;
  min-width: 21px;
  height: 21px;
  place-items: center;
  border-radius: 999px;
  color: #607086;
  background: #eef2f6;
  font-size: 10px;
}

.route-plan-tab.active {
  border-color: #93c5fd;
  color: #1747b8;
  background: #eff6ff;
  box-shadow: 0 6px 15px rgba(37, 99, 235, 0.12);
}

.route-plan-tab.active small {
  color: #fff;
  background: #2563eb;
}

.route-plan-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 7px;
}

.route-plan-actions .btn,
.route-plan-actions .btn-danger {
  min-height: 40px;
  padding: 7px 10px;
  font-size: 11px;
}

.route-empty-state {
  display: flex;
  width: min(520px, 100%);
  min-width: min(520px, 100%);
  height: 100%;
  min-height: 135px;
  align-items: center;
  justify-content: center;
  gap: 13px;
  padding: 18px;
  border: 1px dashed #b7c8db;
  border-radius: 18px;
  color: #53657a;
  background: rgba(248, 251, 255, 0.82);
  text-align: left;
}

.route-empty-state > span {
  font-size: 31px;
}

.route-empty-state div {
  display: grid;
  gap: 4px;
}

.route-empty-state small {
  color: var(--muted);
  line-height: 1.45;
}

.info-grid-compact {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

@media (hover: hover) {
  .quick-city-option:hover,
  .route-plan-tab:hover,
  .route-create-button:hover,
  .search-toggle:hover {
    border-color: #93c5fd;
    background: #f4f8ff;
  }
}

@media (max-width: 720px) {
  :root {
    --header-height: 58px;
  }

  .topbar {
    grid-template-columns: minmax(96px, 1fr) minmax(72px, auto) 42px;
    grid-template-rows: 48px;
    gap: 6px;
    min-height: calc(var(--header-height) + var(--safe-top));
    padding: calc(5px + var(--safe-top)) calc(57px + var(--safe-right)) 5px calc(8px + var(--safe-left));
  }

  .brand-logo-wrap {
    grid-column: 1;
    grid-row: 1;
    width: 104px;
    min-width: 0;
  }

  .brand-logo-3d {
    width: 102px;
  }

  .brand-wordmark {
    font-size: 19px;
  }

  .city-switcher {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .current-city {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    justify-self: stretch;
    width: 100%;
    max-width: 114px;
    min-height: 40px;
    gap: 4px;
    padding: 6px 8px;
    font-size: 11px;
  }

  .current-city #currentCityName {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .city-popover {
    position: fixed;
    top: calc(62px + var(--safe-top));
    right: calc(8px + var(--safe-right));
    left: calc(8px + var(--safe-left));
    width: auto;
    max-height: min(420px, calc(100dvh - 78px - var(--safe-top) - var(--safe-bottom)));
    transform-origin: top center;
  }

  .search-shell {
    grid-column: 3;
    grid-row: 1;
    width: 42px;
    justify-self: end;
  }

  .search-toggle {
    display: grid;
  }

  .search-shell .search-box {
    display: none;
  }

  .search-shell.open .search-box {
    position: fixed;
    z-index: 1420;
    top: calc(64px + var(--safe-top));
    right: calc(8px + var(--safe-right));
    left: calc(8px + var(--safe-left));
    display: flex;
    width: auto;
    height: 48px;
    padding: 0 14px;
    border-color: #93c5fd;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 16px 42px rgba(27, 55, 88, 0.24);
    animation: mobileSearchIn 0.18s ease both;
  }

  .search-shell.open ~ .filter-strip {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
  }

  .filter-strip {
    position: fixed;
    z-index: 1120;
    top: calc(65px + var(--safe-top));
    right: calc(58px + var(--safe-right));
    left: calc(8px + var(--safe-left));
    display: flex;
    width: auto;
    max-width: none;
    gap: 5px;
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 8px 22px rgba(34, 68, 97, 0.13);
    transition: opacity 0.18s ease, transform 0.18s ease;
    backdrop-filter: blur(12px);
  }

  .filter-chip {
    min-height: 34px;
    padding: 5px 9px;
    font-size: 11px;
  }

  .topbar-toggle {
    top: calc(8px + var(--safe-top));
    right: calc(6px + var(--safe-right));
    width: 42px;
    min-height: 42px;
  }

  .map-gesture-hint {
    bottom: calc(77px + var(--safe-bottom));
  }

  .map-zoom-controls {
    right: calc(8px + var(--safe-right));
    top: 48%;
  }

  .detail-panel {
    max-height: calc(100dvh - 58px - var(--safe-top) - var(--safe-bottom) - 132px);
  }

  .detail-panel.route-visible {
    bottom: calc(72px + var(--safe-bottom));
    max-height: calc(100dvh - 58px - var(--safe-top) - var(--safe-bottom) - 190px);
  }

  .app-shell.nav-collapsed .detail-panel {
    max-height: calc(100dvh - var(--safe-top) - var(--safe-bottom) - 132px);
  }

  .app-shell.nav-collapsed .detail-panel.route-visible {
    max-height: calc(100dvh - var(--safe-top) - var(--safe-bottom) - 190px);
  }

  .floating-mascot {
    width: 56px;
    height: 92px;
  }

  .route-drawer {
    height: min(420px, 56vh);
  }

  .route-drawer.collapsed {
    height: 58px;
  }

  .route-header {
    height: 58px;
  }

  .route-handle {
    height: 58px;
    padding: 8px 8px 8px 12px;
  }

  .route-create-button {
    min-height: 40px;
    margin-right: 8px;
    padding: 6px 9px;
    font-size: 11px;
  }

  .route-content {
    height: calc(100% - 58px);
    padding: 9px 10px 13px;
  }

  .route-plan-toolbar {
    display: grid;
    gap: 8px;
    margin-bottom: 8px;
  }

  .route-plan-actions {
    justify-content: flex-end;
  }

  .route-plan-actions .btn,
  .route-plan-actions .btn-danger {
    min-height: 36px;
  }

  .route-plan-tab {
    min-height: 38px;
  }

  .timeline {
    height: calc(100% - 82px);
  }

  .route-empty-state {
    min-width: 82vw;
    min-height: 150px;
  }

  .info-grid-compact {
    grid-template-columns: 1fr;
  }
}

@keyframes mobileSearchIn {
  from { opacity: 0; transform: translateY(-7px) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
